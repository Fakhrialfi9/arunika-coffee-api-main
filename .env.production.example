# Production deployment template.
# Inject secrets at runtime. Never commit real keys or tokens.

# --------------------------------
# APPLICATION
# --------------------------------
NODE_ENV=production
APP_NAME=arunika-main
APP_HOST=0.0.0.0
APP_PORT=3000
APP_API_PREFIX=api
APP_API_VERSION=1
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# --------------------------------
# AUTHENTICATION
# --------------------------------
AUTH_JWT_ISSUER=arunika-auth
AUTH_JWT_AUDIENCE=arunika-api
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_PUBLIC_KEY=<inject-public-key-at-runtime>

# --------------------------------
# GRPC
# --------------------------------
GRPC_USERS_HOST=<users-service-host>
GRPC_USERS_PORT=50051
GRPC_USERS_INTERNAL_TOKEN=<inject-shared-secret-at-runtime>
USERS_GRPC_TIMEOUT_MS=3000
GRPC_MASTER_HOST=<master-service-host>
GRPC_MASTER_PORT=50053
MASTER_GRPC_TIMEOUT_MS=3000
GRPC_PRODUCTS_HOST=<products-service-host>
GRPC_PRODUCTS_PORT=50052
PRODUCTS_GRPC_TIMEOUT_MS=3000

# --------------------------------
# SECURITY
# --------------------------------
SECURITY_CORS_ORIGINS=<allowed-origins>
SECURITY_RATE_LIMIT_TTL=60000
SECURITY_RATE_LIMIT_MAX=100
SECURITY_BODY_LIMIT=1mb
SECURITY_TRUST_PROXY=<deployment-specific-proxy>

# --------------------------------
# OBSERVABILITY
# --------------------------------
OTEL_SERVICE_NAME=arunika-main
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=<inject-endpoint-if-used>
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=<inject-endpoint-if-used>
OTEL_METRIC_EXPORT_INTERVAL=60000

# --------------------------------
# LOGGING
# --------------------------------
LOG_ENABLED=true
LOG_LEVEL=info
