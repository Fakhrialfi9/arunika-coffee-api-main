# --------------------------------
# APPLICATION
# --------------------------------

NODE_ENV=development
APP_NAME=arunika-main
APP_HOST=0.0.0.0
APP_PORT=3000
APP_API_PREFIX=api
APP_API_VERSION=1
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# --------------------------------
# AUTHENTICATION
# --------------------------------

AUTH_JWT_ISSUER=arunika-auth
AUTH_JWT_AUDIENCE=arunika-api
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_PUBLIC_KEY=<inject-public-key>

# --------------------------------
# SECURITY
# --------------------------------

SECURITY_CORS_ORIGINS=http://localhost:3000
SECURITY_RATE_LIMIT_TTL=60000
SECURITY_RATE_LIMIT_MAX=100
SECURITY_BODY_LIMIT=1mb
SECURITY_TRUST_PROXY=loopback

# --------------------------------
# GRPC
# --------------------------------

# USERS
GRPC_USERS_HOST=localhost
GRPC_USERS_PORT=50051
GRPC_USERS_INTERNAL_TOKEN=<development-only-shared-token>
USERS_GRPC_TIMEOUT_MS=3000

# MASTER
GRPC_MASTER_HOST=localhost
GRPC_MASTER_PORT=50053
MASTER_GRPC_TIMEOUT_MS=3000

# PRODUCTS
GRPC_PRODUCTS_HOST=localhost
GRPC_PRODUCTS_PORT=50052
PRODUCTS_GRPC_TIMEOUT_MS=3000

# --------------------------------
# OBSERVABILITY
# --------------------------------

OTEL_SERVICE_NAME=arunika-main
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=60000

# --------------------------------
# LOGGING
# --------------------------------

LOG_ENABLED=true
LOG_LEVEL=debug
