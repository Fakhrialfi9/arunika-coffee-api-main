{
  "name": "arunika-main",
  "version": "0.0.1",
  "type": "module",
  "description": "Arunika Coffee API",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "fresh": "bash scripts/fresh-install.sh",
    "clean:hard": "bash scripts/hard-clean.sh",
    "clean:soft": "bash scripts/soft-clean.sh",
    "clean": "rm -rf dist node_modules/.cache generated tsconfig.build.tsbuildinfo && npm run clean:soft",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:e2e": "vitest run --config vitest.e2e.config.ts --coverage",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check:health": "npm run lint && npm run typecheck && npm run test && npm run format && npm run format:check && npm run build",
    "check:fresh": "npm run clean && npm install && npm run check:health"
  },
  "dependencies": {    
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",

    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/microservices": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",

    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",

    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",

    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "joi": "18.2.3",

    "jose": "6.2.8",

    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",

    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",

    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",

    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",

    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",

    "@vitest/coverage-v8": "4.1.10",

    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.0.0",

    "prettier": "3.9.6",

    "source-map-support": "0.5.21",

    "supertest": "7.2.2",

    "tsconfig-paths": "4.2.0",

    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",

    "vitest": "4.1.10"
  }
}
